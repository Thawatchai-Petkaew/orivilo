{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ORIVILO semantic tokens (DESIGN.md §3, v1.1 mood E). Every value references a primitive; colour tokens carry a light and a dark value. Components and recipes use these names; pages never reach past them. Scope studio marks the Studio's own tokens, never carried by a profile; scope identity marks the tokens that carry ORIVILO's look, overridden by every profile (E2-3).",
  "surface": {
    "canvas": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.50}",
        "dark": "{color.gray.900}"
      },
      "$description": "Page background"
    },
    "card": {
      "$type": "color",
      "$value": {
        "light": "{color.white}",
        "dark": "{color.gray.800}"
      },
      "$description": "Content containers, inputs, menus"
    },
    "raised": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.25}",
        "dark": "{color.gray.800}"
      },
      "$description": "A surface on a card: menus, popovers, nested panels. Dark takes the card value so a control inside keeps 3.0 against its edge"
    },
    "sunken": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.100}",
        "dark": "{color.gray.950}"
      },
      "$description": "Wells, code blocks, table headers"
    },
    "hover": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.100}",
        "dark": "{color.gray.700}"
      },
      "$description": "Hover ground for rows, ghost buttons, nav items"
    },
    "selected": {
      "$type": "color",
      "$value": {
        "light": "{color.violet.50}",
        "dark": "{color.violet.950}"
      },
      "$description": "Selected row, chosen option",
      "$extensions": {
        "orivilo": {
          "scope": "identity"
        }
      }
    },
    "disabled": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.200}",
        "dark": "{color.gray.700}"
      },
      "$description": "Disabled controls"
    },
    "inverse": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.900}",
        "dark": "{color.gray.50}"
      },
      "$description": "Inverse blocks, toasts, tooltips"
    },
    "scrim": {
      "$type": "color",
      "$value": {
        "light": "{color.black}",
        "dark": "{color.black}"
      },
      "$description": "Behind overlays, at opacity.scrim"
    }
  },
  "text": {
    "primary": {
      "$type": "color",
      "$value": {
        "light": "{color.gray.900}",
        "dark": "{color.gray.100}"
      },
      "$description": "Body, headings, values",
      "$extensions": {
        "orivilo": {
          "contrast": {
            "against": "surface.canvas",
            "floor": 4.5
          }
