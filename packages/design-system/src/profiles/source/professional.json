        },
        "md": {
          "$value": {
            "fontFamily": "{font.family.plex-sans}",
            "fontSize": "{font.size.32}",
            "lineHeight": "{font.line-height.1-25}",
            "fontWeight": "{font.weight.600}",
            "letterSpacing": "{font.letter-spacing.tight}"
          }
        }
