# Names only. Real values live in Vercel (Preview, Production) and your local .env.local, never in git.
# What each holds and where it comes from: docs/specs/ORV-38/spec.md, "Environment".

# The app's database login: Supabase transaction pooler (port 6543) as orivilo_app.<project-ref>
DATABASE_URL=

# 32 random bytes, base64: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's own origin, e.g. http://localhost:3000 locally; previews derive it from VERCEL_URL
BETTER_AUTH_URL=

# The Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
